# === APP ===
APP_NAME="Atria API"
DEBUG=false
API_V1_PREFIX="/api/v1"

# === DATABASE ===
# Formatter: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://atria:atria_dev@localhost:5432/atria

# === AUTHENTICATION ===
# SAME value as NEXTAUTH_SECRET in the .env.local of the frontend
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=cambia-esto-por-un-secreto-real-de-al-menos-32-chars

# === GOOGLE CLOUD STORAGE ===
GCS_BUCKET_NAME=atria-files
GCS_PROJECT_ID=tu-proyecto-gcp

# === CORS ===
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# === DEFAULT LIMITS (if the user does not have an assigned plan) ===
DEFAULT_MAX_PROJECTS=5
DEFAULT_MAX_COLLABORATORS=3
DEFAULT_MAX_STORAGE_MB=500
